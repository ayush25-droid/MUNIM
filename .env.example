# Copy to backend/.env and adjust.

# Ollama on the RTX 4060 laptop. Use http://localhost:11434 when running on that machine.
OLLAMA_HOST=http://172.1.58.57:11434
OLLAMA_MODEL=gemma4:latest

# Hard limits - see the hardware section of IMPLEMENTATION.md before changing either.
# The model advertises a 131072 context; requesting anything near it OOMs an 8GB GPU.
OLLAMA_NUM_CTX=4096
OLLAMA_KEEP_ALIVE=30m

# Request timeouts in seconds. Past these, extract() falls back to the rule extractor.
# Vision calls on a bill photo take longer than a line of text.
LLM_TIMEOUT=25
LLM_VISION_TIMEOUT=40

# Longest edge in pixels that an image is downscaled to before it reaches the model.
# Raising this blows the context window and makes every scan crawl. See IMPLEMENTATION.md.
IMAGE_MAX_EDGE=1024

DB_PATH=munim.db
DEMO_SHOP_ID=1

# Max upload for a bill photo, in megabytes.
MAX_UPLOAD_MB=15

# Voice input prototype (feature/voice-input branch, not on main). faster-whisper
# runs on CPU on purpose -- the GPU is reserved for gemma4:latest, see
# IMPLEMENTATION.md's "never load a second model". "small" is multilingual
# (en/hi/kn) and transcribes a few seconds of speech in roughly real time on CPU.
WHISPER_MODEL_SIZE=small
WHISPER_COMPUTE_TYPE=int8
